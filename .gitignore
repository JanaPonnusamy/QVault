# QVault — version control ignore rules.
# Source is always tracked; generated, binary and runtime artifacts are not.

# --- Caches / build / IDE ---
__pycache__/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/
.idea/
node_modules/
dist/
build/
release/
bin/
obj/
logs/
temp/
tmp/
cache/

# --- Local environment overrides ---
config/.env

# --- Runtime data / artifacts ---
storage/
downloads/
frames/
thumbnails/
transcripts/
embeddings/
exports/
output/

# --- Generated / temp file types ---
*.log
*.tmp
*.cache
*.sqlite
*.sqlite3
*.db
*.csv
*.zip
*.7z
*.rar
*.bak
*.old
*.orig

# --- Media ---
*.mp4
*.mkv
*.avi
*.mov
*.webm
*.mp3
*.wav
*.m4a
*.flac
*.ogg
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp

# --- Documents / office ---
*.pdf
*.doc
*.docx
*.ppt
*.pptx
*.xls
*.xlsx

# Source files are explicitly tracked (never ignored):
#   *.py *.tsx *.ts *.js *.jsx *.json *.sql *.yaml *.yml *.toml
#   *.ini *.css *.scss *.html *.md
