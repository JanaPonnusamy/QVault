# QVault environment configuration (template).
# Copy to config/.env to override defaults. All variables are optional.

QVAULT_APP_NAME=QVault
QVAULT_ENV=development
QVAULT_LOG_LEVEL=INFO

QVAULT_API_HOST=127.0.0.1
QVAULT_API_PORT=8000

QVAULT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# db_backend selects the target: "sqlite" (default) or "sqlserver".
# QVAULT_DATABASE_URL (if set) is an explicit SQLAlchemy URL that overrides everything.
QVAULT_DB_BACKEND=sqlite
# QVAULT_DATABASE_URL=sqlite:///database/qvault.db

# SQL Server target (used when QVAULT_DB_BACKEND=sqlserver):
QVAULT_MSSQL_SERVER=192.168.10.73
QVAULT_MSSQL_PORT=1433
QVAULT_MSSQL_DATABASE=QVault
QVAULT_MSSQL_USER=sa
QVAULT_MSSQL_PASSWORD=Admin123
QVAULT_MSSQL_DRIVER=ODBC Driver 17 for SQL Server
QVAULT_MSSQL_TRUST_CERT=true

QVAULT_STORAGE_DIR=storage

QVAULT_JWT_SECRET=change-me-in-production-qvault-secret-key
QVAULT_JWT_EXPIRE_MINUTES=720

# External tools (leave as-is to use PATH)
QVAULT_FFMPEG_PATH=ffmpeg
QVAULT_FFPROBE_PATH=ffprobe

# yt-dlp cookie auth (Instagram/YouTube may require a logged-in session for
# some content — "empty media response" errors mean this is needed). Set at
# most one; cookies file takes precedence over cookies-from-browser.
# QVAULT_YTDLP_COOKIES_FILE=/path/to/cookies.txt
# QVAULT_YTDLP_COOKIES_FROM_BROWSER=chrome

# Frame extraction tuning
QVAULT_FRAME_MAX_COUNT=200
QVAULT_FRAME_MIN_INTERVAL=2.0

# Automatic question detection tuning
QVAULT_QUESTION_THRESHOLD=0.55
QVAULT_DEDUP_MAD=0.012
QVAULT_MERGE_THRESHOLD=0.35

# NCERT acquisition source
QVAULT_NCERT_PAGE_URL=https://ncert.nic.in/textbook.php
QVAULT_NCERT_FILES_BASE=https://ncert.nic.in/textbook/pdf
QVAULT_NCERT_RETRY_COUNT=3
QVAULT_NCERT_CONCURRENT_DOWNLOADS=2
QVAULT_NCERT_TIMEOUT=60

# Seed admin (created on first run)
QVAULT_ADMIN_USERNAME=admin
QVAULT_ADMIN_PASSWORD=admin123
QVAULT_ADMIN_EMAIL=admin@qvault.local

# --- Knowledge Research module (LLM) ---
# OpenAI-compatible endpoint; for OpenRouter use https://openrouter.ai/api/v1
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
